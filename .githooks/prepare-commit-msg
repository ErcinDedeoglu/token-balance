#!/usr/bin/env bash
# Generated shared entry point. repo-scaffold and repo-quality both write these
# exact bytes; neither skill owns this file. Gates live in .githooks/commit-gates.
# Adding a rule here is the bug this file exists to prevent: the last installer
# to write it silently wins and the other skill's gate disappears.
exec bash "$(git rev-parse --show-toplevel)/.githooks/commit-gates" "$@"
